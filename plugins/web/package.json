{
  "name": "@tsugimori/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@tsugimori/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-tc": "5.3.1",
    "@lucide/vue": "1.60.0",
    "@primeuix/themes": "2.0.3",
    "@primevue/core": "4.5.5",
    "@primevue/metadata": "4.5.5",
    "@primevue/nuxt-module": "4.5.5",
    "@tailwindcss/vite": "4.3.3",
    "marked": "18.3.0",
    "nuxt": "4.5.2",
    "primevue": "4.5.5",
    "tailwindcss": "4.3.3",
    "tailwindcss-primeui": "0.6.1",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "vue-tsc": "3.3.11"
  },
  "scripts": {
    "dev": "node ui/scripts/styles/cli.ts && nuxt dev ui --dotenv /dev/null",
    "build": "node ui/scripts/styles/cli.ts && nuxt generate ui --dotenv /dev/null && node ui/scripts/package.mjs",
    "typecheck": "node ui/scripts/styles/cli.ts && nuxt typecheck ui --dotenv /dev/null",
    "preview": "node scripts/preview.mjs"
  }
}
